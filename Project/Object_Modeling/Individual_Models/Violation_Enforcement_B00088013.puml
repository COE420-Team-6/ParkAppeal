@startuml
title ParkAppeal - Class Diagram (Violation Enforcement)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 16
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #B6B5EF
skinparam ClassBorderColor #111111
skinparam ClassBorderThickness 1.6
skinparam ClassFontColor #111111
skinparam ClassFontSize 13
skinparam StereotypeFontColor #111111
skinparam ArrowColor #111111
skinparam ArrowThickness 1.3
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #111111
skinparam NoteFontSize 11
skinparam TitleFontColor #23395B
skinparam TitleFontSize 22
skinparam TitleFontStyle plain
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #111111
skinparam PackageBackgroundColor #FAFAFA
skinparam PackageBorderColor #555555
skinparam PackageFontSize 14
skinparam PackageFontStyle plain
skinparam nodesep 40
skinparam ranksep 55
hide empty members
hide circle
abstract class User <<D1>> #ED9EED {
  - userId : String
  - name : String
  - email : String
  - passwordHash : String
  + authenticate(password : String) : boolean
}
class ParkingOfficer <<D1>> #ED9EED {
  - badgeNumber : String
  - assignedZone : String
  + lookUpPlate(plate : String) : Vehicle
  + issueViolation(plate : String,
  {method}    type : ViolationType,
  {method}    location : String) : Violation
  + attachPhoto(violationId : String,
  {method}    photo : ViolationEvidence) : void
}
class Administrator <<D1>> #ED9EED {
  - adminId : String
  + reviewUnmatched() : List<Violation>
  + linkToVehicle(violationId : String,
  {method}    vehicleId : String) : void
  + voidViolation(violationId : String,
  {method}    reason : String) : VoidRecord
}
class Violation <<D3>> {
  - violationId : String
  - licensePlate : String
  - violationType : ViolationType
  - location : String
  - issuedAt : Date
  - fineAmount : double
  - isVoided : boolean
  + getIssuedAt() : Date
  + markVoided(reason : String) : void
  + isUnmatched() : boolean
  + getEvidenceCount() : int
}
class ViolationEvidence <<D3>> {
  - evidenceId : String
  - fileName : String
  - fileType : String
  - fileSizeBytes : long
  - capturedAt : Date
  + isValid() : boolean
}
class VoidRecord <<D3>> {
  - voidId : String
  - reason : String
  - voidedBy : String
  - voidedAt : Date
  + isReasonValid() : boolean
}
class ViolationService <<Process 2.0>> {
  - {static} MAX_PHOTOS : int = 5
  - {static} MAX_FILE_SIZE_MB : int = 5
  + lookUpVehicle(plate : String) : Vehicle
  + recordViolation(officerId : String,
  {method}    plate : String,
  {method}    type : ViolationType,
  {method}    location : String) : Violation
  + attachEvidence(violationId : String,
  {method}    photo : ViolationEvidence) : void
  + listUnmatched() : List<Violation>
  + linkToVehicle(violationId : String,
  {method}    vehicleId : String) : void
  + voidViolation(violationId : String,
  {method}    adminId : String,
  {method}    reason : String) : VoidRecord
  + canRecord(user : User) : boolean
}
class Vehicle <<D1>> #FFFFFF {
  - vehicleId : String
  - licensePlate : String
  - ownerId : String
  + getActivePermit() : Permit
}
class Permit <<D2>> #FFFFFF {
  - permitId : String
  - permitType : String
  - expiryDate : Date
  + isValid() : boolean
}
class Appeal <<D4>> #FFFFFF {
  - appealId : String
  - status : AppealStatus
  + getStatus() : AppealStatus
}
class NotificationService <<Process 5.0>> #FFFFFF {
  + notifyViolationIssued(v : Violation) : void
}
enum ViolationType #FFFFFF {
  EXPIRED_PERMIT
  NO_VALID_PERMIT
  RESERVED_BAY
  OBSTRUCTING_ACCESS
  OUTSIDE_MARKED_BAY
}

User <|-- ParkingOfficer
User <|-- Administrator

ParkingOfficer "1" -down- "0..*" Violation : <back:#C5C5C5> issues > </back>
Administrator "1" -down- "0..*" VoidRecord : <back:#C5C5C5> records > </back>
Violation "1" -left- "0..1" VoidRecord : <back:#C5C5C5> voided by > </back>
Violation "0..*" -down- "0..1" Vehicle : <back:#C5C5C5> recorded against > </back>
Violation "1" -down- "0..5" ViolationEvidence : <back:#C5C5C5> evidenced by > </back>
Violation "1" -down- "0..1" Appeal : <back:#C5C5C5> disputed by > </back>
Vehicle "1" -down- "0..*" Permit : <back:#C5C5C5> holds > </back>
Violation .down.> ViolationType

ViolationService .left.> Violation : <back:#C5C5C5> creates / voids </back>
ViolationService .up.> NotificationService : <back:#C5C5C5> Violation Issued Event </back>

legend bottom left
  <back:#ED9EED>   </back> Actor (DFD external entity)
  <back:#B6B5EF>   </back> Violation class (Process 2.0, D3)
  <back:#FFFFFF>   </back> Reference class or enum
  D1 User and Vehicle Registry, D2 Permit Records,
  D3 Violation Records, D4 Appeal Records
  Contributor: B00088013
end legend
@enduml
