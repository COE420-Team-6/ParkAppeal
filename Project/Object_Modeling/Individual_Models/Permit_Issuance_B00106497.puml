@startuml
title ParkAppeal - Class Diagram (Permit Issuance and Eligibility)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 16
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #B6B5EF
skinparam ClassBorderColor #111111
skinparam ClassBorderThickness 1.6
skinparam ClassFontColor #111111
skinparam ClassFontSize 13
skinparam StereotypeFontColor #111111
skinparam ArrowColor #111111
skinparam ArrowThickness 1.3
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #111111
skinparam NoteFontSize 11
skinparam TitleFontColor #23395B
skinparam TitleFontSize 22
skinparam TitleFontStyle plain
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #111111
skinparam PackageBackgroundColor #FAFAFA
skinparam PackageBorderColor #555555
skinparam PackageFontSize 14
skinparam PackageFontStyle plain
skinparam nodesep 40
skinparam ranksep 55
hide empty members
hide circle
abstract class User <<D1>> #ED9EED {
  - userId : String
  - name : String
  - email : String
  - passwordHash : String
  + authenticate(password : String) : boolean
}
class Administrator <<D1>> #ED9EED {
  - adminId : String
  + configureEligibility(typeId : String,
  {method}    criteria : String) : void
  + setQuota(typeId : String,
  {method}    quota : int) : void
  + reviewEligibility(applicationId : String) : PermitApplication
  + decideApplication(applicationId : String,
  {method}    approve : boolean) : void
  + viewPermitsByStatus(status : PermitStatus) : List<Permit>
}
class PermitHolder <<D1>> #ED9EED {
  + applyForPermit(vehicleId : String,
  {method}    typeId : String,
  {method}    documents : List<File>) : PermitApplication
}
class PermitType <<D2>> {
  - typeId : String
  - name : String
  - eligibilityCriteria : String
  - quota : int
  - issuedCount : int
  + hasQuotaRemaining() : boolean
  + incrementIssued() : void
}
class PermitApplication <<D2>> {
  - applicationId : String
  - submittedAt : Date
  - documents : List<File>
  - status : ApplicationStatus
  - eligibilityResult : boolean
  - unmetCriteria : List<String>
  + setEligibility(result : boolean,
  {method}    unmet : List<String>) : void
  + setStatus(newStatus : ApplicationStatus) : void
}
class Permit <<D2>> {
  - permitId : String
  - permitNumber : String
  - startDate : Date
  - expiryDate : Date
  - status : PermitStatus
  + isValid() : boolean
  + markExpired() : void
}
class PermitService <<Process 1.0>> {
  + checkEligibility(application : PermitApplication) : boolean
  + issuePermit(applicationId : String) : Permit
  + listPending() : List<PermitApplication>
  + listByStatus(status : PermitStatus) : List<Permit>
  + expirePermits(today : Date) : int
}
class Vehicle <<D1>> #FFFFFF {
  - vehicleId : String
  - licensePlate : String
}
class NotificationService <<Process 5.0>> #FFFFFF {
  + notifyPermitStatusChange(application : PermitApplication) : void
}
enum ApplicationStatus #FFFFFF {
  PENDING
  APPROVED
  REJECTED
}
enum PermitStatus #FFFFFF {
  ACTIVE
  EXPIRED
}

User <|-down- Administrator
User <|-down- PermitHolder

PermitHolder "1" -down- "0..*" PermitApplication : <back:#C5C5C5> submits > </back>
Administrator "0..1" -down- "0..*" PermitApplication : <back:#C5C5C5> decides > </back>
PermitApplication "0..*" -down- "1" PermitType : <back:#C5C5C5> requests > </back>
PermitApplication "0..*" -left- "1" Vehicle : <back:#C5C5C5> for > </back>
PermitApplication "1" -down- "0..1" Permit : <back:#C5C5C5> results in > </back>
Permit "0..*" -right- "1" PermitType : <back:#C5C5C5> of type > </back>
Vehicle "1" -down- "0..*" Permit : <back:#C5C5C5> holds > </back>

PermitService .up.> Permit : <back:#C5C5C5> issues / expires </back>
PermitService .right.> NotificationService : <back:#C5C5C5> Permit Status Change </back>
PermitApplication .right.> ApplicationStatus
Permit .down.> PermitStatus
PermitType -[hidden]down- PermitService

legend bottom left
  <back:#ED9EED>   </back> Actor (DFD external entity)
  <back:#B6B5EF>   </back> Permit class (Process 1.0, D2)
  <back:#FFFFFF>   </back> Reference class or enum
  D1 User and Vehicle Registry, D2 Permit Records
  Contributor: B00106497
end legend
@enduml
