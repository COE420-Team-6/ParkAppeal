@startuml
title ParkAppeal - Class Diagram (App UI)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 16
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #B6B5EF
skinparam ClassBorderColor #111111
skinparam ClassBorderThickness 1.6
skinparam ClassFontColor #111111
skinparam ClassFontSize 13
skinparam StereotypeFontColor #111111
skinparam ArrowColor #111111
skinparam ArrowThickness 1.3
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #111111
skinparam NoteFontSize 11
skinparam TitleFontColor #23395B
skinparam TitleFontSize 22
skinparam TitleFontStyle plain
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #111111
skinparam PackageBackgroundColor #FAFAFA
skinparam PackageBorderColor #555555
skinparam PackageFontSize 14
skinparam PackageFontStyle plain
skinparam nodesep 40
skinparam ranksep 55
hide empty members
hide circle
abstract class Page <<UI>> {
  - title : String
  + {abstract} render() : void
}
class LoginPage <<UI>> {
  - username : String
  - password : String
  - errorMessage : String
  + login() : boolean
  + validateInput() : boolean
  + showError() : void
  + clearFields() : void
}
class Dashboard <<UI>> {
  - userId : String
  - recentAppeals : List<Appeal>
  - recentViolations : List<Violation>
  + displayDashboard() : void
  + loadUserData() : void
  + showRecentAppeals() : void
  + showRecentViolations() : void
}
class AppealForm <<UI>> {
  - violationId : String
  - reason : String
  - evidenceFiles : List<File>
  - isValid : boolean
  + addEvidence(file : File) : void
  + removeEvidence(file : File) : void
  + validateForm() : boolean
  + submitAppeal() : boolean
  + resetForm() : void
}
class SearchFilter <<UI>> {
  - status : String
  - startDate : Date
  - endDate : Date
  - keyword : String
  + applyFilter() : List<Appeal>
  + clearFilter() : void
  + setStatus(status : String) : void
  + setDateRange(start : Date,
  {method}    end : Date) : void
}

Page <|-- LoginPage
Page <|-- Dashboard
Page <|-- AppealForm

LoginPage "1" -right- "1" Dashboard : <back:#C5C5C5> navigates to > </back>
Dashboard "1" -down- "0..1" AppealForm : <back:#C5C5C5> opens > </back>
Dashboard "1" -right- "0..1" SearchFilter : <back:#C5C5C5> uses > </back>

legend bottom left
  <back:#B6B5EF>   </back> UI class (this model)
  Appeal and Violation are defined in the
  Appeals and Violation Enforcement models.
  Contributor: B00104714
end legend
@enduml
